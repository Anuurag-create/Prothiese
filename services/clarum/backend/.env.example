# Add your Google AI Studio key here. Do not commit .env or expose this key to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta

# Local Prothiese shell origins. Add your production frontend origin when deploying.
CLARUM_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
